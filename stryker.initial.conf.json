{
  "mutate": [
    "baseline/src/**/*.js"
  ],
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "concurrency": 2,
  "timeoutMS": 2000,
  "thresholds": {
    "high": 98,
    "low": 80,
    "break": 0
  },
  "htmlReporter": {
    "fileName": "reports/initial/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/initial/mutation.json"
  },
  "jest": {
    "config": {
      "roots": [
        "<rootDir>/baseline/test"
      ],
      "collectCoverageFrom": [
        "baseline/src/**/*.js"
      ],
      "testPathIgnorePatterns": [
        "melhorias"
      ]
    }
  }
}
